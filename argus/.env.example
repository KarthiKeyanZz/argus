# Copy to argus/.env (or run `make env`, which generates a random DB password).
# Never commit the real .env.

# --- PostgreSQL container (compose.yaml) ---------------------------------------
POSTGRES_USER=argus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=argus
POSTGRES_PORT=5433

# --- Backend (all ARGUS_* variables map to app/core/config.py) -----------------
ARGUS_ENVIRONMENT=dev
ARGUS_LOG_LEVEL=INFO
ARGUS_DATABASE_URL=postgresql://argus:change-me@127.0.0.1:5433/argus
# Lists are JSON:
# ARGUS_ALLOWED_HOSTS=["127.0.0.1","localhost"]
# ARGUS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Local LLM (Ollama) ---------------------------------------------------------
ARGUS_OLLAMA_BASE_URL=http://127.0.0.1:11434
ARGUS_LLM_CHAT_MODEL=gemma4:26b-a4b-it-qat
ARGUS_LLM_EMBED_MODEL=nomic-embed-text
ARGUS_LLM_DEFAULT_NUM_CTX=8192
ARGUS_LLM_KEEP_ALIVE=15m
